# Global agent defaults. Empty fields in the UI inherit these values.
# Individual agents can override provider, name, base_url, and api_key.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-openai-api-key-here

# For Groq, use MODEL_PROVIDER=openai (the compatible adapter),
# MODEL_NAME=llama-3.3-70b-versatile, BASE_URL=https://api.groq.com/openai/v1,
# and a Groq API_KEY. Keep endpoint, model, and credential matched.

# Create a key: https://platform.openai.com/api-keys
# Setup: docs/SETUP.md
# API usage is billed separately from ChatGPT subscriptions.

# Optional UI port (default: 5173).
# FRONTEND_PORT=5174

# Defaults for loop-counter nodes and engine cycles (positive integers).
# A node's explicit config.max_iterations overrides the loop-counter default.
LOOP_COUNTER_MAX_ITERATIONS=10
ENGINE_MAX_ITERATIONS=100
